// Tang Nano 4K camera stream overlay: camera.cst (banks: 1 = 3.3 V, 2 = 2.5 V, 3 = 1.8 V) plus the SiP
// HyperRAM, which nextpnr places from the chipdb (sip_cst) by name; 1-bit ports are named without [0].
IO_LOC "clk" 45;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "btn[0]" 14;
IO_LOC "btn[1]" 15;
IO_PORT "btn[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_PORT "btn[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "cam_scl" 44;
IO_PORT "cam_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_sda" 46;
IO_PORT "cam_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_xclk" 33;
IO_PORT "cam_xclk" IO_TYPE=LVCMOS25 PULL_MODE=NONE;
IO_LOC "cam_pclk" 41;
IO_PORT "cam_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_href" 42;
IO_PORT "cam_href" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_vsync" 43;
IO_PORT "cam_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// cam_d[7:0] = PIXDATA9..2
IO_LOC "cam_d[0]" 17;
IO_LOC "cam_d[1]" 19;
IO_LOC "cam_d[2]" 20;
IO_LOC "cam_d[3]" 18;
IO_LOC "cam_d[4]" 16;
IO_LOC "cam_d[5]" 23;
IO_LOC "cam_d[6]" 39;
IO_LOC "cam_d[7]" 40;
IO_PORT "cam_d[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "cam_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "cam_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// SiP HyperRAM: placed by nextpnr from the chipdb (sip_cst); bank 3 is 1.8 V
IO_PORT "O_hpram_ck[0]" IO_TYPE=LVCMOS18;
IO_PORT "O_hpram_ck_n[0]" IO_TYPE=LVCMOS18;
IO_PORT "O_hpram_cs_n[0]" IO_TYPE=LVCMOS18;
IO_PORT "O_hpram_reset_n[0]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_rwds[0]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[0]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[1]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[2]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[3]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[4]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[5]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[6]" IO_TYPE=LVCMOS18;
IO_PORT "IO_hpram_dq[7]" IO_TYPE=LVCMOS18;
// HDMI (as in hdmi.cst)
IO_LOC "tmds_clk_p" 28;
IO_LOC "tmds_clk_n" 27;
IO_LOC "tmds_d_p[0]" 30;
IO_LOC "tmds_d_n[0]" 29;
IO_LOC "tmds_d_p[1]" 32;
IO_LOC "tmds_d_n[1]" 31;
IO_LOC "tmds_d_p[2]" 35;
IO_LOC "tmds_d_n[2]" 34;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
