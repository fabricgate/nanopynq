// clk + led only, for the toolchain smoke test (blinky.v has no uart/btn ports).
// NOTE: led is 1 bit wide, and yosys/nextpnr name a 1-bit port "led", not "led[0]" (verified: "led[0]" -> Unconstrained IO).
IO_LOC "clk" 45;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
