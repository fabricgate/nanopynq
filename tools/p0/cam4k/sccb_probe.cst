// Tang Nano 4K camera P0 probe. Banks: 1 = 3.3 V, 2 = 2.5 V, 3 = 1.8 V (schematic sheet 1).
IO_LOC "clk" 45;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "btn[0]" 14;
IO_LOC "btn[1]" 15;
IO_PORT "btn[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_PORT "btn[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "cam_scl" 44;
IO_PORT "cam_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_sda" 46;
IO_PORT "cam_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "cam_xclk" 33;
IO_PORT "cam_xclk" IO_TYPE=LVCMOS25 PULL_MODE=NONE;
IO_LOC "cam_vsync" 43;
IO_PORT "cam_vsync" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_hsync" 42;
IO_PORT "cam_hsync" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_pclk" 41;
IO_PORT "cam_pclk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
